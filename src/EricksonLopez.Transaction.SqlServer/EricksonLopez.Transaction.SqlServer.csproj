<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>EricksonLopez.Transaction.SqlServer</RootNamespace>
    <AssemblyName>EricksonLopez.Transaction.SqlServer</AssemblyName>
    <Description>Microsoft SQL Server connection factory, transaction extensions, and SQL Server error code classifier for EricksonLopez.Transaction.</Description>
    <PackageId>EricksonLopez.Transaction.SqlServer</PackageId>
    <PackageTags>$(CommonPackageTags);sqlserver;mssql;sqlclient;savepoints;snapshot-isolation;deadlock-detection;database-provider</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Transaction.Abstractions\EricksonLopez.Transaction.Abstractions.csproj" />
    <ProjectReference Include="..\EricksonLopez.Transaction\EricksonLopez.Transaction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
