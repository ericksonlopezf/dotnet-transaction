<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>EricksonLopez.Transaction.Sqlite</RootNamespace>
    <AssemblyName>EricksonLopez.Transaction.Sqlite</AssemblyName>
    <Description>SQLite connection factory, transaction extensions, and SQLite error code classifier for EricksonLopez.Transaction using Microsoft.Data.Sqlite.</Description>
    <PackageId>EricksonLopez.Transaction.Sqlite</PackageId>
    <PackageTags>$(CommonPackageTags);sqlite;sqlite3;microsoft-data-sqlite;savepoints;wal-mode;deadlock-detection;database-provider</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Transaction.Abstractions\EricksonLopez.Transaction.Abstractions.csproj" />
    <ProjectReference Include="..\EricksonLopez.Transaction\EricksonLopez.Transaction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
